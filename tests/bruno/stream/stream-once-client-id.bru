meta {
  name: Stream once with clientId query keeps the smoke mode
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/stream?once=1&clientId=3f2b8c1e-9a4d-4e6f-8b2a-1c3d5e7f9a0b
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("client identity does not break the ready frame", function() {
    expect(res.getHeader("content-type")).to.include("text/event-stream");
    expect(res.body).to.include("event: ready");
  });
}
