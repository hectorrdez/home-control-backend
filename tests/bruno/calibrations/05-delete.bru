meta {
  name: Calibrations: DELETE removes
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/calibrations/cover.bruno_calibration_test
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns an empty array", function() {
    expect(res.body.data).to.be.an("array").that.is.empty;
  });
}
