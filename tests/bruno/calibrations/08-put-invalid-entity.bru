meta {
  name: Calibrations: invalid entity id
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/calibrations/Cover.Bad
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"openMs":15000,"closeMs":14000}
}

assert {
  res.status: eq 400
}

tests {
  test("typed invalid_entity_id error", function() {
    expect(res.body.error).to.equal("invalid_entity_id");
  });
}
