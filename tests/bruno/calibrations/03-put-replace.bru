meta {
  name: Calibrations: PUT replaces existing
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/calibrations/cover.bruno_calibration_test
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"openMs":16000,"closeMs":15500}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the replaced entry", function() {
    expect(res.body.data).to.be.an("array").with.length(1);
    expect(res.body.data[0].openMs).to.equal(16000);
    expect(res.body.data[0].closeMs).to.equal(15500);
  });
}
