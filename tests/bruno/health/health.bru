meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.data[0].online: eq true
  res.body.data[0].db: eq up
}

tests {
  test("API is online and the database is up", function() {
    expect(res.body.data).to.be.an("array");
    expect(res.body.data[0].online).to.equal(true);
    expect(res.body.data[0].db).to.equal("up");
  });
}
