meta {
  name: Cover percent: entity not in HA (404)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/entities/cover.bruno_missing_test/cover-percent
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"percent":100}
}

assert {
  res.status: eq 404
}

tests {
  test("typed entity_not_found error", function() {
    expect(res.body.error).to.equal("entity_not_found");
  });
}
