meta {
  name: Cover percent: invalid entity id
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/entities/Cover.Bad/cover-percent
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"percent":50}
}

assert {
  res.status: eq 400
}

tests {
  test("typed invalid_entity_id error", function() {
    expect(res.body.error).to.equal("invalid_entity_id");
  });
}
