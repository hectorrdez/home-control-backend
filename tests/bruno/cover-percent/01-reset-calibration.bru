meta {
  name: Cover percent: reset calibration
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/calibrations/cover.bruno_calibration_test
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("calibration removed", function() {
    expect(res.body.data).to.deep.equal([]);
  });
}
