meta {
  name: Presets: DELETE again is idempotent
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/presets/{{presetId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("still 200 with an empty array", function() {
    expect(res.body.data).to.deep.equal([]);
  });
}
