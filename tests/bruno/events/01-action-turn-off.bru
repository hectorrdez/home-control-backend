meta {
  name: Events: an action on the test switch succeeds
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/entities/switch.interruptor_bano_interruptor_2/action
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
  X-Client-Id: 123e4567-e89b-12d3-a456-426614174018
}

body:json {
  {"action":"turn_off"}
}

script:pre-request {
  bru.setVar("actionSentAt", Date.now());
}

assert {
  res.status: eq 200
}

tests {
  test("the action response is unchanged", function() {
    expect(res.body.data[0].entityId).to.equal("switch.interruptor_bano_interruptor_2");
  });
}
