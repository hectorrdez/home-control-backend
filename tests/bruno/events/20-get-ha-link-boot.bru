meta {
  name: Events: boot ha_link is connected
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/events?types=ha_link&limit=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("the newest ha_link event is the boot connection", function() {
    expect(res.body.data).to.have.length(1);
    expect(res.body.data[0].type).to.equal("ha_link");
    expect(res.body.data[0].payload.connected).to.equal(true);
  });
}
