meta {
  name: Events: PUT a test alias
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/aliases/sensor.bruno_event_test
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"alias":"Event test"}
}

assert {
  res.status: eq 200
}

tests {
  test("the alias is stored", function() {
    expect(res.body.data[0].alias).to.equal("Event test");
  });
}
