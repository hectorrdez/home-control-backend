meta {
  name: Alert rules: PUT onto an existing trigger conflicts
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/alert-rules/{{alertRuleAboveId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"entityId":"light.bruno_alert_test","trigger":{"type":"above","value":25},"level":"low"}
}

assert {
  res.status: eq 409
}

tests {
  test("typed duplicate_rule error", function() {
    expect(res.body.error).to.equal("duplicate_rule");
  });
}
