meta {
  name: Alert rules: POST message over 120 characters
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/alert-rules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"entityId":"light.bruno_alert_test","trigger":{"type":"interacted"},"level":"low","message":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}
}

assert {
  res.status: eq 400
}

tests {
  test("typed invalid_rule error", function() {
    expect(res.body.error).to.equal("invalid_rule");
  });
}
