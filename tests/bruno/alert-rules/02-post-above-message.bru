meta {
  name: Alert rules: POST creates above rule with message
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/alert-rules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"entityId":"light.bruno_alert_test","trigger":{"type":"above","value":20},"level":"low","message":"Too bright"}
}

assert {
  res.status: eq 200
}

tests {
  test("keeps the message and numeric trigger value", function() {
    const r = res.body.data[0];
    expect(r.trigger).to.deep.equal({ type: "above", value: 20 });
    expect(r.message).to.equal("Too bright");
    bru.setVar("alertRuleAboveId", r.id);
  });
}
