meta {
  name: Alert rules: POST duplicate trigger conflicts
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/alert-rules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"entityId":"light.bruno_alert_test","trigger":{"type":"connects"},"level":"low"}
}

assert {
  res.status: eq 409
}

tests {
  test("typed duplicate_rule error", function() {
    expect(res.body.error).to.equal("duplicate_rule");
  });
}
