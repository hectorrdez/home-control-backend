meta {
  name: Alert rules: DELETE again is idempotent
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/api/alert-rules/{{alertRuleId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns an empty array when the rule is already gone", function() {
    expect(res.body.data).to.be.an("array").that.is.empty;
  });
}
