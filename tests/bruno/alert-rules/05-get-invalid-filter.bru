meta {
  name: Alert rules: GET invalid entityId filter
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/alert-rules?entityId=BAD
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 400
}

tests {
  test("typed invalid_entity_id error", function() {
    expect(res.body.error).to.equal("invalid_entity_id");
  });
}
