meta {
  name: Alert rules: cleanup above 25 rule
  type: http
  seq: 18
}

delete {
  url: {{baseUrl}}/api/alert-rules/{{alertRuleAbove25Id}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("cleanup returns an empty array", function() {
    expect(res.body.data).to.be.an("array").that.is.empty;
  });
}
