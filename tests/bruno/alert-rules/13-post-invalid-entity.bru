meta {
  name: Alert rules: POST invalid entityId
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/alert-rules
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"entityId":"BAD ID","trigger":{"type":"connects"},"level":"low"}
}

assert {
  res.status: eq 400
}

tests {
  test("typed invalid_entity_id error", function() {
    expect(res.body.error).to.equal("invalid_entity_id");
  });
}
