meta {
  name: Control: turn_off on an idle test switch
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/entities/switch.interruptor_bano_interruptor_2/action
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"action":"turn_off"}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the new normalized state", function() {
    const e = res.body.data[0];
    expect(e.entityId).to.equal("switch.interruptor_bano_interruptor_2");
    expect(e.domain).to.equal("switch");
    expect(e.state).to.equal("off");
  });
}
