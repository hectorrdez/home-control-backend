meta {
  name: Persistence: GET no longer lists the alias
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/aliases
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

assert {
  res.status: eq 200
}

tests {
  test("does not contain the deleted alias", function() {
    expect(res.body.data.some((a) => a.entityId === "sensor.bruno_persist_test")).to.equal(false);
  });
}
