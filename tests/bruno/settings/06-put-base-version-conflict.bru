meta {
  name: Settings: PUT with stale baseVersion returns 409 with current setting
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/settings/test.bruno-settings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
}

body:json {
  {"value":{"cols":6,"name":"Salon"},"baseVersion":1}
}

assert {
  res.status: eq 409
}

tests {
  test("returns version_conflict carrying the current setting", function() {
    expect(res.body.error).to.equal("version_conflict");
    expect(res.body.data).to.be.an("array").with.length(1);
    expect(res.body.data[0].version).to.equal(2);
    expect(res.body.data[0].value).to.deep.equal({ cols: 5, name: "Salon" });
  });
}
