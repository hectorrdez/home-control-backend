meta {
  name: Settings: PUT creates a new key at version 1
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/settings/test.bruno-settings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
  X-Client-Id: 123e4567-e89b-12d3-a456-426614174017
}

body:json {
  {"value":{"cols":4,"name":"Salon"}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the stored setting at version 1", function() {
    expect(res.body.data).to.be.an("array").with.length(1);
    expect(res.body.data[0].key).to.equal("test.bruno-settings");
    expect(res.body.data[0].version).to.equal(1);
    expect(res.body.data[0].updatedBy).to.equal("123e4567-e89b-12d3-a456-426614174017");
    expect(res.body.data[0].value).to.deep.equal({ cols: 4, name: "Salon" });
  });
}
