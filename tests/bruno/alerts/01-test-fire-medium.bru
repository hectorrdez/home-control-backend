meta {
  name: Alerts: test-fire medium creates an alert
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/alerts/test-fire
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
  X-Client-Id: 123e4567-e89b-12d3-a456-426614174099
}

body:json {
  {"entityId":"switch.bruno_alert_test","level":"medium","text":"Bruno alert"}
}

assert {
  res.status: eq 200
}

tests {
  test("Alerts: test-fire medium creates an alert", function() {
    const r = res.body.data[0];
        expect(r.id).to.be.a("string").and.not.empty;
        expect(r.level).to.equal("medium");
        expect(r.ackedAt).to.equal(null);
        bru.setVar("alertId", r.id);
  });
}
