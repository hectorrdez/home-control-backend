meta {
  name: Alerts: second ack keeps the first ackedAt
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/alerts/{{alertId}}/ack
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
  X-Client-Id: 123e4567-e89b-12d3-a456-426614174099
}

assert {
  res.status: eq 200
}

tests {
  test("Alerts: second ack keeps the first ackedAt", function() {
    expect(res.body.data[0].ackedAt).to.equal(bru.getVar("ackedAt"));
  });
}
