# Copy to .env and fill in. .env is gitignored.

# API
API_PORT=3002
API_TOKEN=
# ^ key the FRONTEND sends to this API: Authorization: Bearer <API_TOKEN>. Empty = gate disabled (local dev only); required in prod.
#   Different from HA_TOKEN (this API -> Home Assistant).
CORS_ORIGINS=
# ^ comma-separated exact origin allowlist (e.g. https://home-control.hectorrdez.es,http://localhost:5173);
#   empty = reflect any Origin (local dev), credentials stay allowed
ALIASES_FILE=./data/aliases.json
# ^ legacy import source only: read once at startup if the aliases table is empty, then renamed to *.imported-<ms>. Data lives in Postgres.
LOG_TO_FILE=false
# ^ true = also write CSV logs under data/ (needs a writable directory)

# Home Assistant
HA_URL=http://192.168.50.200:8123
# ^ HA base URL (LAN). In Dokploy use the homelab LAN IP, not localhost.
HA_TOKEN=
# ^ HA long-lived access token (HA profile > Security). Never commit. Lives in the parent folder's .env, outside the repos (F:/proyectos/home-control/.env); copy it into this repo .env and into Dokploy env.

CALIBRATIONS_FILE=./data/calibrations.json
# ^ legacy import source only (same one-time import as ALIASES_FILE). Data lives in Postgres.
ALERT_RULES_FILE=./data/alert-rules.json
# ^ legacy import source only (same one-time import as ALIASES_FILE). Data lives in Postgres.

# PostgreSQL (compose service `db`; api reaches it as host `db`)
POSTGRES_DB=homecontrol
POSTGRES_USER=homecontrol
POSTGRES_PASSWORD=
# ^ never commit. Generate a random value; the same value goes in PGPASSWORD.
PGHOST=localhost
# ^ for `npm run dev` on the host (compose sets PGHOST=db for the api container itself)
PGPORT=5432
PGDATABASE=homecontrol
PGUSER=homecontrol
PGPASSWORD=
# ^ same value as POSTGRES_PASSWORD
DB_POOL_MAX=5
PG_PUBLISH_PORT=5432
# ^ host port for the db on 127.0.0.1 (compose.local.yaml only). Use 5433 if 5432 is taken.
