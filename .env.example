# Copy to .env and fill in. .env is gitignored.

# API
API_PORT=3002
API_TOKEN=
# ^ key the FRONTEND sends to this API: Authorization: Bearer <API_TOKEN>. Empty = gate disabled (local dev only); required in prod.
#   Different from HA_TOKEN (this API -> Home Assistant).
CORS_ORIGINS=
# ^ comma-separated exact origin allowlist (e.g. https://app.example.com);
#   empty = reflect any Origin (local dev), credentials stay allowed
LOG_TO_FILE=false
# ^ true = also write CSV logs under data/ (needs a writable directory)

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASS=
DB_ROOT_PASS=

# Mail (optional; used by src/resources/utils/Mailer.ts)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Home Assistant
HA_URL=http://192.168.50.200:8123
# ^ HA base URL (LAN). In Dokploy use the homelab LAN IP, not localhost.
HA_TOKEN=
# ^ HA long-lived access token (HA profile > Security). Never commit. Lives in the parent folder's .env, outside the repos (F:/proyectos/home-control/.env); copy it into this repo .env and into Dokploy env.
