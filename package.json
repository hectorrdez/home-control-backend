{
  "name": "home-control-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node-dev --cache-directory .ts-node --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:cov": "vitest run --coverage",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.19",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@usebruno/cli": "^2.15.1",
    "@vitest/coverage-v8": "5.0.5",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  }
}
